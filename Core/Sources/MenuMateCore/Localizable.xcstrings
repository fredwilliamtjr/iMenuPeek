{
  "sourceLanguage": "en",
  "strings": {
    "preset.copyPath": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Path"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar caminho"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制路径"
          }
        }
      }
    },
    "preset.newFile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New File"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novo arquivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建文件"
          }
        }
      }
    },
    "preset.goUp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go Up One Level"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Subir um nível"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往上一层级目录"
          }
        }
      }
    },
    "test.unsupportedType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No built-in sample can satisfy this file type."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma amostra embutida atende a este tipo de arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有能匹配该文件类型的内置样本。"
          }
        }
      }
    },
    "test.invalidCount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate between 1 and 20 sample items."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere de 1 a 20 itens de amostra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样本数量必须在 1–20 之间。"
          }
        }
      }
    },
    "test.sampleMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The generated samples do not satisfy the action’s selection rules."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As amostras geradas não atendem às regras de seleção da ação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成的样本不满足此动作的类型或数量条件。"
          }
        }
      }
    },
    "test.folderType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹"
          }
        }
      }
    },
    "test.appType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用包"
          }
        }
      }
    },
    "test.unsupportedVariantDirectory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action uses a custom submenu directory. Generated trial runs currently support only the standard Templates directory; your files will not be used."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação usa um diretório de submenu personalizado. Os testes com amostras geradas só aceitam, por enquanto, o diretório padrão Templates; seus arquivos não serão usados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此动作使用自定义子菜单目录。临时样本试运行目前仅支持标准 Templates 目录，不会使用你的真实文件。"
          }
        }
      }
    },
    "storage.invalidJournal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pack recovery record is invalid. Backups have been preserved."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de recuperação do pacote é inválido. Os backups foram preservados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展包恢复记录无效，已保留备份。"
          }
        }
      }
    },
    "storage.invalidPackKey": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pack installation path is invalid."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho de instalação do pacote é inválido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展包安装路径无效。"
          }
        }
      }
    },
    "storage.pendingRecovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interrupted pack operation must be recovered first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso recuperar antes uma operação de pacote interrompida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先恢复上次中断的扩展包操作。"
          }
        }
      }
    },
    "storage.configurationChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration changed during this operation. Please try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração mudou durante esta operação. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作期间配置已被修改，请重试。"
          }
        }
      }
    },
    "preset.toggleHidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Unhide"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar / Reexibir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 / 显示"
          }
        }
      }
    }
  },
  "version": "1.0"
}
