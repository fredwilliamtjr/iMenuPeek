    },
    "editor.deletePresetMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset will be removed from the context menu; the script file is kept and can be recovered later via \"General › Restore Factory Presets\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta predefinição será removida do menu de contexto; o arquivo de script é mantido e pode ser recuperado depois em \"Geral › Restaurar predefinições de fábrica\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该预设将从右键菜单移除;脚本文件保留,可日后用「通用 › 恢复出厂预设」找回。"
          }
        }
      }
    },
