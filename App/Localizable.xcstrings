    "packs.errorBusy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this pack’s dialogs and wait for its actions to finish before updating or uninstalling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche as janelas deste pacote e aguarde as ações dele terminarem antes de atualizar ou desinstalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请关闭此包的弹窗，并等待动作执行完毕后再更新或卸载。"
          }
        }
