    "openWith.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicates in the \"Open With\" menu usually come from multiple disk copies of the same app. After scanning, you can unregister each copy individually; the copy currently in use is protected."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicatas no menu \"Abrir com\" geralmente vêm de várias cópias do mesmo app no disco. Após a busca, você pode remover o registro de cada cópia individualmente; a cópia em uso fica protegida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「打开方式」菜单里的重复项,通常来自同一 App 的多份磁盘拷贝。扫描后可逐份反注册,当前正在使用的拷贝会被保护。"
          }
        }
      }
    },
