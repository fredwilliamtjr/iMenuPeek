    "editor.deleteActionMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will be removed from the context menu. This cannot be undone. The script file will not be deleted."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação será removida do menu de contexto. Não é possível desfazer. O arquivo de script não será apagado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该动作将从右键菜单移除,此操作不可撤销。脚本文件不会被删除。"
          }
        }
      }
    },
    "editor.deleteConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "editor.deletePresetConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete preset “%@”?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
